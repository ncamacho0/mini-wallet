# Clave del MCP de Context7 (docs). Opcional: sin ella el MCP funciona con rate limits menores.
# Copia este archivo a .env y rellena el valor. .env está en .gitignore, nunca lo commitees.
CONTEXT7_API_KEY=

# Latencia del backend mockeado (0 la desactiva; se usa en E2E para tener tests deterministas).
MW_MOCK_LATENCY=1

# Milisegundos del fault "timeout" (por defecto 6000).
MW_MOCK_TIMEOUT_MS=6000
